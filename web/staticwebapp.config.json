{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api",
      "/api/*",
      "/backend",
      "/backend/*",
      "/assets/*",
      "/*.{css,js,map,json,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,ttf,txt}"
    ]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
